<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 겉에 테두리 라인을 그립니다 -->
    <item

        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">

        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <stroke
                android:width="5dp"
                android:color="@android:color/holo_green_light" />
        </shape>
    </item>
</layer-list>
